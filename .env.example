# Frontend: copy to frontend/.env for local use or set these in hosting dashboard.
# Leave API URL blank in local Vite development (Vite proxies /api to localhost:8000).
VITE_API_URL=
# Optional Supabase public client configuration. Never use service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend: set these in the API process environment (backend/.env for your own setup).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional local resume improver. Install/run Ollama separately and pull a local model.
# Set to "ollama" to use it; "rules" keeps the deterministic fallback only.
LLM_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=45

# Optional local semantic similarity; install backend/requirements-embeddings.txt first.
# Downloads model weights locally on first use; can exceed free-host memory limits.
ENABLE_SENTENCE_TRANSFORMERS=false
